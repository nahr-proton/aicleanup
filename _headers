# Cloudflare Pages headers.
# Applied at the edge; no effect on the local dev server.

/*
  # Content Security Policy. Every origin below is one this site actually
  # uses. There are no inline scripts or inline styles anywhere in the site,
  # which is why 'unsafe-inline' is absent and should stay absent.
  #
  #   cdnjs.cloudflare.com  SheetJS, loaded on demand for .xlsx downloads
  #   cdn.jsdelivr.net      docx, loaded on demand for .docx downloads
  #   cloud.umami.is        Umami analytics SCRIPT is loaded from here
  #   gateway.umami.is      Umami analytics BEACONS are sent here. This is a
  #                         different host from the script, and it must be in
  #                         connect-src or every pageview is silently blocked.
  #
  # WHEN ENABLING ADSENSE, add to script-src and connect-src:
  #   https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net
  # and add to img-src and frame-src:
  #   https://*.google.com https://*.doubleclick.net https://*.googlesyndication.com
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cloud.umami.is; connect-src 'self' https://cloud.umami.is https://gateway.umami.is; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

  # Stops the site being framed for clickjacking.
  X-Frame-Options: DENY

  # Never let a browser second guess a declared content type.
  X-Content-Type-Options: nosniff

  # Send the origin to other sites, the full path only to ourselves.
  Referrer-Policy: strict-origin-when-cross-origin

  # No tool here needs any of these, so switch them all off.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()

  # Two years, preload eligible. Remove this if the domain must ever serve
  # anything over plain HTTP.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# The dev tool has an inline <style> block, so it needs its own looser policy.
# It is also disallowed in robots.txt and carries a noindex tag.
/_dev/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:
  X-Robots-Tag: noindex, nofollow

# Asset filenames are not content hashed: site.js is always site.js. With a
# long max-age a returning visitor keeps running old code for the rest of that
# window after every deploy, which is confusing to debug and means the site is
# briefly inconsistent with itself.
#
# no-cache does NOT mean "do not store". The browser keeps the file and asks
# "has this changed?" on each request; the ETag answers 304 Not Modified and
# nothing is re-downloaded. The cost is one small conditional request, and
# changes are live immediately.
#
# Swap back to a long max-age once filenames carry a content hash.
/assets/*
  Cache-Control: public, no-cache, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
